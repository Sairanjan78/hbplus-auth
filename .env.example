# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the client;
# they are identifiers, not secrets (security comes from Firebase rules + domain checks).

# Firebase web app config (Firebase console > Project settings > Your apps > Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs (Google Cloud console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# Access policy
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit
# Comma-separated emails that get the Admin role on first login (must match firestore.rules)
EXPO_PUBLIC_ADMIN_EMAILS=admin@hbplus.fit
